project_id         = "YOUR_GCP_PROJECT_ID"
region             = "us-central1"
zone               = "us-central1-a"
instance_name      = "isaac-sim-trainer"
machine_type       = "g2-standard-8"
gpu_type           = "nvidia-l4"
gpu_count          = 1
boot_disk_size_gb  = 150
use_spot           = false # Set to true for ~70% cost savings
vpc_name           = "bpx-training-vpc"
subnet_cidr        = "10.0.1.0/24"

# Set your public IP CIDR here (run `curl -s https://checkip.amazonaws.com` to find your IP)
# Example: ["203.0.113.19/32"]
allowed_client_ips = ["YOUR_PUBLIC_IP/32"]
